# Chaîne de connexion Neon (Dashboard Neon > Connect), avec ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Même adresse SANS "-pooler" : connexion directe, utilisée seulement par Prisma pour les migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Clé de signature des sessions admin, 32 caractères minimum.
# Générer avec : openssl rand -base64 32
SESSION_SECRET=""

# Compte admin temporaire, utilisable avant la mise en place de la base.
# Mot de passe : 12 caractères minimum. À retirer une fois le compte créé
# en base avec `npm run admin:create`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Envoi des codes de connexion (OTP) par e-mail, via n'importe quel serveur SMTP
# (Gmail avec mot de passe d'application, Resend, Brevo, hébergeur…).
# Sans ces valeurs, en développement, le code s'affiche dans le terminal de `npm run dev`.
# En production, ils sont obligatoires.
# Avec Resend (choix retenu) : SMTP_USER vaut littéralement "resend" et SMTP_PASSWORD est la clé API
# (re_…). MAIL_FROM doit utiliser le domaine vérifié dans Resend.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD=""
MAIL_FROM="Cabinet PKM <no-reply@pkm.cd>"
